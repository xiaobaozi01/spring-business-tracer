{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spring-business-tracer/graph-node.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "entryMembership", "services"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "type": {"enum": ["SYMBOL", "TABLE", "DATA_RESOURCE"]},
    "entryMembership": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "services": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
