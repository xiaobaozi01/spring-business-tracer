{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spring-business-tracer/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "toolkitVersion", "runId", "graphHash", "fingerprints", "contexts", "services", "sharedModules", "entrypoints", "tables", "boundaries", "codeGraphTools", "graph", "tombstones", "graphDelta", "audits"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "toolkitVersion": {"const": "2.0.0"},
    "runId": {"type": "string"},
    "graphHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "fingerprints": {"$ref": "#/$defs/fingerprints"},
    "contexts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "contextHash"]}},
    "services": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "root"]}},
    "sharedModules": {"type": "array", "items": {"type": "object", "required": ["id", "root"]}},
    "entrypoints": {"type": "array", "items": {"type": "object", "required": ["id", "status"]}},
    "tables": {"type": "array", "items": {"type": "object", "required": ["name", "operations", "evidence"]}},
    "boundaries": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "key", "source", "target", "status", "deliverySemantics", "evidence"]}},
    "codeGraphTools": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "graph": {"type": "object", "required": ["nodeCount", "edgeCount", "formatVersion", "topologyRootHash"], "properties": {"nodeCount": {"type": "integer", "minimum": 0}, "edgeCount": {"type": "integer", "minimum": 0}, "formatVersion": {"const": 2}, "topologyRootHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}},
    "tombstones": {"type": "object", "required": ["entryIds", "nodeIds", "edgeIds"]},
    "graphDelta": {"type": ["object", "null"]},
    "audits": {"type": "object", "required": ["coverageHash", "boundaryHash", "configHash"], "properties": {"coverageHash": {"type": "string", "minLength": 1}, "boundaryHash": {"type": "string", "minLength": 1}, "configHash": {"type": "string", "minLength": 1}}}
  },
  "$defs": {
    "fingerprints": {"type": "object", "additionalProperties": false, "required": ["config", "source", "index", "toolkit", "resolvedConfig", "adapterRegistry"], "properties": {"config": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "index": {"type": "string", "minLength": 1}, "toolkit": {"type": "string", "minLength": 1}, "resolvedConfig": {"type": "string", "minLength": 1}, "adapterRegistry": {"type": "string", "minLength": 1}}}
  }
}
