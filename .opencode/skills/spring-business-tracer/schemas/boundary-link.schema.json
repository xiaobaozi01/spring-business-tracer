{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spring-business-tracer/boundary-link.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "kind", "key", "source", "status", "sourceEvidence", "targetEvidence"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["FEIGN_HTTP", "REST_TEMPLATE_HTTP", "WEBCLIENT_HTTP", "GATEWAY_HTTP", "HTTP", "RABBIT", "KAFKA", "JMS", "ROCKETMQ", "DUBBO", "GRPC", "SPRING_EVENT"]},
    "key": {"type": "string", "minLength": 1},
    "channelKey": {"type": "string", "minLength": 1},
    "consumerGroup": {"type": "string", "minLength": 1},
    "sourceService": {"type": "string"},
    "targetService": {"type": "string"},
    "source": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "targets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "deliverySemantics": {"enum": ["DIRECT", "FAN_OUT_GROUPS", "COMPETING_ONE_OF", "POTENTIAL"]},
    "sourceEvidence": {"$ref": "#/$defs/evidence"},
    "targetEvidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "additionalEvidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "status": {"enum": ["CANDIDATE", "VERIFIED", "UNRESOLVED", "REJECTED"]}
  },
  "oneOf": [{"required": ["target"]}, {"required": ["targets", "deliverySemantics"]}],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "contains": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      }
    }
  }
}
