{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spring-business-tracer/config.schema.json",
  "title": "Spring Business Tracer V2.0 配置",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "language", "workspace", "output", "codeGraph", "analysis", "analysisContexts", "configResolution", "adapterRegistry", "entrypoints", "crossService", "persistence", "incremental", "publication", "graph", "batching", "resume", "verification"],
  "properties": {
    "version": {"const": "2.0.0"},
    "language": {"const": "java"},
    "workspace": {"type": "object", "additionalProperties": false, "required": ["services", "sharedModules", "autoDiscoverSingleService", "requireAllServiceRootsIndexed"], "properties": {
      "services": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "root", "codeGraphProjectPath", "packages", "aliases"], "properties": {"id": {"type": "string", "minLength": 1}, "root": {"type": "string", "minLength": 1}, "codeGraphProjectPath": {"type": "string", "minLength": 1}, "packages": {"type": "array", "items": {"type": "string"}}, "aliases": {"type": "array", "items": {"type": "string"}}}}},
      "sharedModules": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "root", "codeGraphProjectPath", "packages", "aliases"], "properties": {"id": {"type": "string", "minLength": 1}, "root": {"type": "string", "minLength": 1}, "codeGraphProjectPath": {"type": "string", "minLength": 1}, "packages": {"type": "array", "items": {"type": "string"}}, "aliases": {"type": "array", "items": {"type": "string"}}}}},
      "autoDiscoverSingleService": {"type": "boolean"}, "requireAllServiceRootsIndexed": {"const": true}
    }},
    "output": {"type": "object", "required": ["directory", "language", "manifest"], "properties": {"directory": {"const": "docs/spring-business"}, "language": {"const": "zh-CN"}, "writeEvidence": {"type": "boolean"}, "manifest": {"const": "manifest.json"}}},
    "codeGraph": {"type": "object", "required": ["requiredCapabilities", "queryLimit", "requireCompleteStatus", "allowNativeCallGraphFallback", "allowTextSearchCallGraphFallback"], "properties": {"serverNamePattern": {"type": "string"}, "requiredCapabilities": {"type": "array", "contains": {"const": "callees"}}, "queryLimit": {"type": "integer", "minimum": 2, "maximum": 1000}, "requireCompleteStatus": {"const": true}, "allowNativeCallGraphFallback": {"const": false}, "allowTextSearchCallGraphFallback": {"const": false}}},
    "analysis": {"type": "object", "required": ["maxDepth", "maxBranches"], "properties": {"maxDepth": {"type": "integer", "minimum": 1}, "maxBranches": {"type": "integer", "minimum": 1}, "includeTests": {"type": "boolean"}, "includeGenerated": {"type": "boolean"}, "collapsePackages": {"type": "array", "items": {"type": "string"}}}},
    "analysisContexts": {"type": "object", "additionalProperties": false, "required": ["defaultContext", "definitions"], "properties": {"defaultContext": {"type": "string", "minLength": 1}, "definitions": {"type": "array", "minItems": 1, "items": {"$ref": "analysis-context.schema.json"}}}},
    "configResolution": {"type": "object", "additionalProperties": false, "required": ["externalSourcePolicy", "environmentPolicy", "secretPolicy", "executeSpel", "maxSourceBytes", "maxTotalBytes"], "properties": {"externalSourcePolicy": {"const": "PARTIAL"}, "environmentPolicy": {"const": "DENY"}, "secretPolicy": {"const": "HASH_ONLY"}, "executeSpel": {"const": false}, "maxSourceBytes": {"const": 1048576}, "maxTotalBytes": {"const": 8388608}}},
    "adapterRegistry": {"type": "object", "additionalProperties": false, "required": ["builtInVersion", "allowScripts", "customDefinitions"], "properties": {"builtInVersion": {"const": "2.0.0"}, "allowScripts": {"const": false}, "customDefinitions": {"type": "array", "items": {"$ref": "adapter-definition.schema.json"}}}},
    "entrypoints": {"type": "object", "required": ["enabledAdapters", "verifiedAdapters", "experimentalAdapters", "customAnnotations"], "properties": {"enabledAdapters": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "verifiedAdapters": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "experimentalAdapters": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "customAnnotations": {"type": "array", "items": {"type": "string"}}}},
    "crossService": {"type": "object", "required": ["enabled", "kinds", "requireTwoSidedEvidence", "unresolvedPolicy", "verifiedKinds", "kafka"], "properties": {"enabled": {"const": true}, "kinds": {"type": "array", "minItems": 1}, "requireTwoSidedEvidence": {"const": true}, "unresolvedPolicy": {"const": "PARTIAL"}, "verifiedKinds": {"type": "array", "minItems": 1, "uniqueItems": true}, "kafka": {"type": "object", "required": ["requireClusterAlias", "consumerGroupSemantics", "dynamicDestinationPolicy"], "properties": {"requireClusterAlias": {"const": true}, "consumerGroupSemantics": {"const": true}, "dynamicDestinationPolicy": {"const": "PARTIAL"}}}}},
    "persistence": {"type": "object", "required": ["verifiedAdapters", "dynamicIdentifierPolicy"], "properties": {"verifiedAdapters": {"type": "array", "minItems": 1, "uniqueItems": true}, "dynamicIdentifierPolicy": {"const": "PARTIAL"}}},
    "incremental": {"type": "object", "required": ["enabled", "strategy", "requireFullEntryRediscovery", "legacyBaselinePolicy"], "properties": {"enabled": {"const": true}, "strategy": {"const": "SERVICE_CLOSURE"}, "requireFullEntryRediscovery": {"const": true}, "legacyBaselinePolicy": {"const": "FULL_REBASE"}}},
    "publication": {"type": "object", "required": ["stagingDirectory", "snapshotDirectory", "currentPointer", "writeIndex", "writeManifest"], "properties": {"stagingDirectory": {"const": "docs/spring-business/.staging"}, "snapshotDirectory": {"const": "docs/spring-business/snapshots"}, "currentPointer": {"const": "docs/spring-business/current.json"}, "writeIndex": {"const": true}, "writeManifest": {"const": true}}},
    "graph": {"type": "object", "additionalProperties": false, "required": ["formatVersion", "sharded", "shardPrefixLength", "diffEnabled", "pathQueryMaxDepth", "pathQueryMaxResults", "recordTombstones", "cursorBoundToSnapshot", "queryWallClockMs", "maxShardBytes"], "properties": {"formatVersion": {"const": 2}, "sharded": {"const": true}, "shardPrefixLength": {"const": 2}, "diffEnabled": {"const": true}, "pathQueryMaxDepth": {"type": "integer", "minimum": 1, "maximum": 20}, "pathQueryMaxResults": {"type": "integer", "minimum": 1, "maximum": 100}, "recordTombstones": {"const": true}, "cursorBoundToSnapshot": {"const": true}, "queryWallClockMs": {"type": "integer", "minimum": 100, "maximum": 10000}, "maxShardBytes": {"type": "integer", "minimum": 1024, "maximum": 8388608}}},
    "batching": {"type": "object", "required": ["batchSize", "discoveryLeaseSeconds", "leaseSeconds", "heartbeatSeconds", "retryLimit", "requireClose", "operationJournalLimit"], "properties": {"batchSize": {"type": "integer", "minimum": 1, "maximum": 100}, "maxConcurrentSubagents": {"type": "integer", "minimum": 1, "maximum": 4}, "discoveryLeaseSeconds": {"type": "integer", "minimum": 30, "maximum": 3600}, "leaseSeconds": {"type": "integer", "minimum": 30}, "heartbeatSeconds": {"type": "integer", "minimum": 1}, "retryLimit": {"type": "integer", "minimum": 0}, "checkpointAfterEachEntry": {"type": "boolean"}, "checkpointAfterEachServiceDiscovery": {"const": true}, "requireClose": {"const": true}, "operationJournalLimit": {"type": "integer", "minimum": 1, "maximum": 2000}}},
    "resume": {"type": "object", "required": ["stateDirectory", "requireConfigHash", "requireSourceSnapshot", "requireIndexFingerprint", "requireToolkitFingerprint"], "properties": {"stateDirectory": {"const": ".opencode/.cache/spring-business-tracer/runs"}, "requireConfigHash": {"const": true}, "requireSourceSnapshot": {"const": true}, "requireIndexFingerprint": {"const": true}, "requireToolkitFingerprint": {"const": true}}},
    "verification": {"type": "object", "required": ["required", "validators", "publishOnlyVerified"], "properties": {"required": {"const": true}, "validators": {"type": "array", "allOf": [{"contains": {"const": "incremental"}}, {"contains": {"const": "config"}}]}, "publishOnlyVerified": {"const": true}}}
  }
}
