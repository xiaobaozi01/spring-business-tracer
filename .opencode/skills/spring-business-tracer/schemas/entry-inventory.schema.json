{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spring-business-tracer/entry-inventory.schema.json",
  "type": "object",
  "required": ["schemaVersion", "runId", "fingerprints", "adapters", "excludedCandidates", "entries"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "runId": {"type": "string"},
    "fingerprints": {"type": "object", "additionalProperties": false, "required": ["config", "source", "index", "toolkit", "resolvedConfig", "adapterRegistry"], "properties": {"config": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "index": {"type": "string", "minLength": 1}, "toolkit": {"type": "string", "minLength": 1}, "resolvedConfig": {"type": "string", "minLength": 1}, "adapterRegistry": {"type": "string", "minLength": 1}}},
    "excludedCandidates": {"type": "array", "items": {"type": "object", "required": ["symbolId", "reason"]}},
    "adapters": {"type": "array", "items": {"type": "object", "required": ["name", "enabled", "count"]}},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "serviceId", "adapter", "adapterDefinitionVersion", "contextIds", "conditions", "visibility", "trigger", "symbolId", "signature", "file", "line", "codeGraphQuery"],
        "properties": {
          "id": {"type": "string"},
          "serviceId": {"type": "string"},
          "adapter": {"type": "string"},
          "adapterDefinitionVersion": {"const": "2.0.0"},
          "contextIds": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "conditions": {"type": "array"},
          "visibility": {"enum": ["PUBLIC", "INTERNAL", "BACKGROUND"]},
          "trigger": {"type": "string"},
          "symbolId": {"type": "string"},
          "signature": {"type": "string"},
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "codeGraphQuery": {"type": "object"}
        }
      },
      "uniqueItems": true
    }
  }
}
