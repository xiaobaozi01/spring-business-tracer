{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"spring-business-tracer/provenance.schema.json","type":"object","additionalProperties":false,"required":["id","schemaVersion","edgeId","sourceKind","assurance","evidence","validatorReportHashes"],"properties":{"id":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"schemaVersion":{"const":"2.0"},"edgeId":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"sourceKind":{"enum":["CODE_GRAPH","ENTRY_INVENTORY","FRAMEWORK_ADAPTER","PROTOCOL_BINDING","PERSISTENCE_ADAPTER","VERIFIED_TRACE"]},"assurance":{"enum":["VERIFIED","CONDITIONAL","POTENTIAL","UNRESOLVED"]},"evidence":{"type":"object"},"validatorReportHashes":{"type":"array","items":{"type":"string"},"uniqueItems":true}},"allOf":[{"if":{"properties":{"sourceKind":{"not":{"const":"ENTRY_INVENTORY"}}}},"then":{"properties":{"validatorReportHashes":{"minItems":1}}}}]}
