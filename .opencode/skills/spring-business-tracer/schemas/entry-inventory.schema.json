{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spring-business-tracer/entry-inventory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "serviceId", "fingerprints", "totalEntries", "adapters", "excludedCandidates", "entries", "queryLog"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "runId": {"type": "string", "minLength": 1},
    "serviceId": {"type": "string", "minLength": 1},
    "totalEntries": {"type": "integer", "minimum": 0},
    "fingerprints": {"type": "object", "additionalProperties": false, "required": ["config", "source", "index", "toolkit", "resolvedConfig", "adapterRegistry"], "properties": {"config": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "index": {"type": "string", "minLength": 1}, "toolkit": {"type": "string", "minLength": 1}, "resolvedConfig": {"type": "string", "minLength": 1}, "adapterRegistry": {"type": "string", "minLength": 1}}},
    "excludedCandidates": {"type": "array", "items": {"type": "object", "required": ["symbolId", "reason"], "properties": {"symbolId": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}}},
    "adapters": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "enabled", "count"], "properties": {"name": {"type": "string", "minLength": 1}, "enabled": {"type": "boolean"}, "count": {"type": "integer", "minimum": 0}}}},
    "entries": {"type": "array", "uniqueItems": true, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "serviceId", "adapter", "adapterDefinitionVersion", "contextIds", "conditions", "visibility", "trigger", "symbolId", "signature", "file", "line", "codeGraphQuery", "beanActivation"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "serviceId": {"type": "string", "minLength": 1}, "adapter": {"type": "string", "minLength": 1},
        "adapterDefinitionVersion": {"const": "2.0.0"}, "contextIds": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "conditions": {"type": "array"}, "visibility": {"enum": ["PUBLIC", "INTERNAL", "BACKGROUND"]}, "trigger": {"type": "string"},
        "symbolId": {"type": "string", "minLength": 1}, "signature": {"type": "string", "minLength": 1}, "file": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1},
        "codeGraphQuery": {"$ref": "#/$defs/codeGraphArgs"},
        "beanActivation": {"type": "object", "additionalProperties": false, "required": ["effective", "evidence"], "properties": {"effective": {"const": true}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}}}}
      }
    }},
    "queryLog": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/query"}}
  },
  "$defs": {
    "codeGraphTool": {"type": "string", "pattern": "^codegraph_[a-z][a-z0-9_]*$"},
    "codeGraphArgs": {"type": "object", "required": ["limit"], "properties": {"limit": {"type": "integer", "minimum": 2, "maximum": 1000}}},
    "query": {"type": "object", "additionalProperties": false, "required": ["tool", "args", "purpose", "resultCount", "truncated", "completionStatus", "summaryOmittedCount"], "properties": {"tool": {"$ref": "#/$defs/codeGraphTool"}, "args": {"$ref": "#/$defs/codeGraphArgs"}, "purpose": {"type": "string", "minLength": 1}, "resultCount": {"type": "integer", "minimum": 0}, "truncated": {"const": false}, "completionStatus": {"const": "EXPLICIT_COMPLETE"}, "summaryOmittedCount": {"const": 0}}}
  }
}
