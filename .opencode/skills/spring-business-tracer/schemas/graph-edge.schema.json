{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spring-business-tracer/graph-edge.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "from", "to", "entryMembership", "services", "evidence", "evidenceHash"],
  "properties": {
    "id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "type": {"enum": ["JAVA_CALL", "CODEGRAPH_SPECIAL", "LOGICAL_BOUNDARY", "PERSISTENCE"]},
    "from": {"type": "string", "minLength": 1},
    "to": {"type": "string", "minLength": 1},
    "entryMembership": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "services": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence": {"type": "object"}
    ,"evidenceHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
    ,"evidenceVariants": {"type": "array", "items": {"type": "object"}}
  }
}
