{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spring-business-tracer/verification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "kind", "entryId", "traceHash", "validator", "decision", "fingerprints", "checks", "queryLog"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "runId": {"type": "string", "minLength": 1},
    "kind": {"const": "TRACE"},
    "entryId": {"type": "string", "minLength": 1},
    "traceHash": {"type": "string", "minLength": 1},
    "validator": {"const": "spring-trace-validator"},
    "decision": {"enum": ["ACCEPTED", "REJECTED", "NEEDS_REVIEW"]},
    "fingerprints": {"$ref": "#/$defs/fingerprints"},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "queryLog": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/query"}},
    "errorCodes": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array"}
  },
  "$defs": {
    "fingerprints": {"type": "object", "additionalProperties": false, "required": ["config", "source", "index", "toolkit", "resolvedConfig", "adapterRegistry"], "properties": {"config": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "index": {"type": "string", "minLength": 1}, "toolkit": {"type": "string", "minLength": 1}, "resolvedConfig": {"type": "string", "minLength": 1}, "adapterRegistry": {"type": "string", "minLength": 1}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["code", "passed", "evidence"], "properties": {"code": {"type": "string", "minLength": 1}, "passed": {"type": "boolean"}, "evidence": {"type": "array", "minItems": 1}}},
    "query": {"type": "object", "required": ["tool", "args", "resultCount", "truncated", "completionStatus", "summaryOmittedCount"], "properties": {"tool": {"type": "string", "pattern": "^codegraph_[a-z][a-z0-9_]*$"}, "args": {"type": "object", "required": ["limit"], "properties": {"limit": {"type": "integer", "minimum": 2, "maximum": 1000}}}, "resultCount": {"type": "integer", "minimum": 0}, "truncated": {"const": false}, "completionStatus": {"const": "EXPLICIT_COMPLETE"}, "summaryOmittedCount": {"const": 0}}}
  }
}
